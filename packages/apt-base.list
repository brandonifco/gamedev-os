# APT packages installed into the image (hook 0300).
# One per line; blank lines and # comments ignored.
# XFCE desktop + display manager come from task-xfce-desktop (see build.sh).

# --- Networking ---
network-manager

# --- Core dev toolchain (.NET/C#) ---
git
git-lfs
build-essential
code                       # VSCode, from Microsoft repo added in hook 0200

# --- Container runtime (rootless, generic) ---
# Warden builds on this when enabled, but Podman is useful on its own.
# Warden-specific deps (ansible) live in components/warden/, not here.
podman
slirp4netns
fuse-overlayfs
uidmap
gh                         # GitHub CLI

# --- Flatpak app backbone (Snap is removed) ---
flatpak
xdg-desktop-portal-gtk
# gnome-software-plugin-flatpak   # intentionally OFF — you chose terminal-only app mgmt

# --- Shell polish ---
fish
zsh

# --- Developer fonts ---
fonts-firacode
fonts-jetbrains-mono

# --- Firewall + automatic security updates ---
ufw
unattended-upgrades

# --- Snapshots / rollback ---
snapper
btrfs-progs

# --- Barebones utilities (deliberately minimal) ---
curl
wget
unzip
openssh-client
htop
nano
vim
gnupg
ca-certificates
